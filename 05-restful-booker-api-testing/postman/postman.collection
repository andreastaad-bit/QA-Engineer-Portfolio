  "item": [
    {
      "name": "POST Auth-Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "let response = pm.response.json();\r",
              "\r",
              "pm.test(\"Response contains token\", function () {\r",
              "    pm.expect(response).to.have.property(\"token\");\r",
              "});\r",
              "\r",
              "pm.environment.set(\"token\", response.token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"password123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST Auth -Login (Invalid Credentials)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"BUG: API devuelve 200 en vez de 401 para credenciales inválidas\", () => {\r",
              "    pm.response.to.have.status(200); // debería ser 401 según estándar REST\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "pm.test(\"Response NO contiene token con credenciales inválidas\", () => {\r",
              "    pm.expect(jsonData).to.not.have.property(\"token\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response contiene reason de error\", () => {\r",
              "    pm.expect(jsonData.reason).to.eql(\"Bad credentials\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"Andrea\",\r\n    \"password\": \"Lolita123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST - Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Response contiene bookingid\", () => {\r",
              "    pm.expect(jsonData).to.have.property(\"bookingid\");\r",
              "});\r",
              "\r",
              "pm.test(\"Los datos del booking coinciden con lo enviado\", () => {\r",
              "    pm.expect(jsonData.booking.firstname).to.eql(\"Andrea\");\r",
              "    pm.expect(jsonData.booking.lastname).to.eql(\"Guerra\");\r",
              "    pm.expect(jsonData.booking.totalprice).to.eql(1230);\r",
              "});\r",
              "\r",
              "pm.environment.set(\"booking_id\", jsonData.bookingid);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\": \"Andrea\",\r\n    \"lastname\": \"Guerra\",\r\n    \"totalprice\": 1230,\r\n    \"depositpaid\": true,\r\n    \"bookingdates\": {\r\n        \"checkin\": \"2026-08-01\",\r\n        \"checkout\": \"2026-08-25\"\r\n    },\r\n    \"additionalneeds\": \"Breakfast\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/booking",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET /booking/{{booking_id}}",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"La reserva devuelta coincide con la creada\", () => {\r",
              "    pm.expect(jsonData.firstname).to.eql(\"Andrea\");\r",
              "    pm.expect(jsonData.lastname).to.eql(\"Guerra\");\r",
              "    pm.expect(jsonData.totalprice).to.eql(1230);\r",
              "});\r",
              "\r",
              "pm.test(\"Tiene fechas de check-in y check-out\", () => {\r",
              "    pm.expect(jsonData.bookingdates).to.have.property(\"checkin\");\r",
              "    pm.expect(jsonData.bookingdates).to.have.property(\"checkout\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/booking/{{booking_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "booking",
            "{{booking_id}}"
          ]
        }
      },
      "response": []
    },
